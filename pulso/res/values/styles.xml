<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Pulso" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

    <!-- Ventana del panel: flotante, sin atenuado propio (lo pone la capa de fondo) -->
    <style name="PulsoPanel" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowElevation">0dp</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowCloseOnTouchOutside">false</item>
        <item name="android:windowAnimationStyle">@style/PanelAnimLeft</item>
    </style>

    <style name="PanelAnimLeft">
        <item name="android:windowEnterAnimation">@anim/panel_in_left</item>
        <item name="android:windowExitAnimation">@anim/panel_out_left</item>
    </style>

    <style name="PanelAnimRight">
        <item name="android:windowEnterAnimation">@anim/panel_in_right</item>
        <item name="android:windowExitAnimation">@anim/panel_out_right</item>
    </style>
</resources>
